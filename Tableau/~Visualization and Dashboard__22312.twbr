      <column caption='RFM_String' datatype='string' name='[Calculation_1533286639030278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_1533286638034947]) + &quot;-&quot; + STR([Calculation_1533286638784516]) + &quot;-&quot; + STR([Calculation_1533286638919685])' />
      </column>
      <column caption='Phan khuc' datatype='string' name='[Calculation_1533286639468551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1533286639030278] = &quot;4-4-4&quot; OR [Calculation_1533286639030278] = &quot;3-4-4&quot; THEN &quot;Most valuable&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &gt;= 3 AND [Calculation_1533286638784516] &gt;= 3 AND [Calculation_1533286638919685] &gt;= 3 THEN &quot;Valuable&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &lt;= 2 AND [Calculation_1533286638784516] &gt;= 3 AND [Calculation_1533286638919685] &gt;= 3 THEN &quot;Churn high spending&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &gt;= 3 AND [Calculation_1533286638784516] &lt;= 2 AND [Calculation_1533286638919685] &gt;= 3 THEN &quot;New high spending&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &gt;= 3 AND [Calculation_1533286638784516] &lt;= 2 AND [Calculation_1533286638919685] &lt;= 2 THEN &quot;New low spending&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &gt;= 3 AND [Calculation_1533286638784516] &gt;= 3 AND [Calculation_1533286638919685] &lt;= 2 THEN &quot;Frequent&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &gt;= 2 AND [Calculation_1533286638784516] &gt;= 2 AND [Calculation_1533286638919685] &gt;= 2 THEN &quot;Regular&quot;&#13;&#10;ELSEIF [Calculation_1533286638034947] &lt;= 2 AND [Calculation_1533286638784516] &lt;= 2 AND [Calculation_1533286638919685] &lt;= 2 THEN &quot;Low spending loyal&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Ti le giu chan' datatype='real' name='[Calculation_1533286639656968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id]) / ATTR({FIXED [cohort_month]: COUNTD([customer_id])})' />
      </column>
