      </column>
      <column caption='First Order Date' datatype='date' name='[Calculation_1008544488779776]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : MIN([order_date]) }' />
      </column>
      <column caption='New Customer' datatype='string' name='[Calculation_1008544488968193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([Calculation_1008544488779776]) = YEAR([order_date])&#13;&#10;THEN &quot;New&quot;&#13;&#10;ELSE &quot;Existing&quot;&#13;&#10;END' />
      </column>
      <column caption='Doanh thu trung binh moi khach hang' datatype='real' name='[Calculation_1008544489365506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])&#13;&#10;/COUNTD([customer_id])' />
      </column>
      <column caption='Loi nhuan trung binh moi khach hang' datatype='real' name='[Calculation_1008544489639940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit])&#13;&#10;/COUNTD([customer_id])' />
      </column>
      <column caption='R_Days' datatype='integer' name='[Calculation_1533286637457408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id]: MAX([order_date])}, {MAX([order_date])})' />
      </column>
      <column caption='F_Orders' datatype='integer' name='[Calculation_1533286637645825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id]: COUNTD([order_id])}' />
      </column>
      <column caption='M_Sales' datatype='integer' name='[Calculation_1533286637776898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id]: SUM([sales])}' />
      </column>
      <column caption='R_Score' datatype='integer' name='[Calculation_1533286638034947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1533286637457408] &lt;= {FIXED : PERCENTILE([Calculation_1533286637457408], 0.25)} THEN 4&#13;&#10;ELSEIF [Calculation_1533286637457408] &lt;= {FIXED : PERCENTILE([Calculation_1533286637457408], 0.50)} THEN 3&#13;&#10;ELSEIF [Calculation_1533286637457408] &lt;= {FIXED : PERCENTILE([Calculation_1533286637457408], 0.75)} THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='F_Score' datatype='integer' name='[Calculation_1533286638784516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1533286637645825] &lt;= {FIXED : PERCENTILE([Calculation_1533286637645825], 0.25)} THEN 1&#13;&#10;ELSEIF [Calculation_1533286637645825] &lt;= {FIXED : PERCENTILE([Calculation_1533286637645825], 0.50)} THEN 2&#13;&#10;ELSEIF [Calculation_1533286637645825] &lt;= {FIXED : PERCENTILE([Calculation_1533286637645825], 0.75)} THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='M_Score' datatype='integer' name='[Calculation_1533286638919685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1533286637776898] &lt;= {FIXED : PERCENTILE([Calculation_1533286637776898], 0.25)} THEN 1&#13;&#10;ELSEIF [Calculation_1533286637776898] &lt;= {FIXED : PERCENTILE([Calculation_1533286637776898], 0.50)} THEN 2&#13;&#10;ELSEIF [Calculation_1533286637776898] &lt;= {FIXED : PERCENTILE([Calculation_1533286637776898], 0.75)} THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
