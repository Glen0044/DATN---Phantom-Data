    <worksheet name='Tỷ lệ lỗ Market'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Semibold' fontsize='12'>Loss-making order rate by Market</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='superstore_sql_import' name='federated.0o0txaw0915gk11a4zif600uh7xu' />
          </datasources>
          <datasource-dependencies datasource='federated.0o0txaw0915gk11a4zif600uh7xu'>
            <column caption='Loss-making order rate' datatype='real' name='[Calculation_1562429734612992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [profit] &lt; 0 THEN &#13;&#10;[order_id] END) / COUNT([order_id])' />
