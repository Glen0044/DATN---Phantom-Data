          <datasource-dependencies datasource='federated.0o0txaw0915gk11a4zif600uh7xu'>
            <column caption='Discount Band 1' datatype='string' name='[Calculation_1038245665333251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [discount] &lt;= 0.1 THEN &quot;0–10%&quot;&#13;&#10;ELSEIF [discount] &lt;= 0.3 THEN &quot;10–30%&quot;&#13;&#10;ELSEIF [discount] &lt;= 0.5 THEN &quot;30–50%&quot;&#13;&#10;ELSE &quot;50%+&quot;&#13;&#10;END' />
            </column>
