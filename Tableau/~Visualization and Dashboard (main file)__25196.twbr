      <table>
        <view>
          <datasources>
            <datasource caption='superstore_sql_import' name='federated.0o0txaw0915gk11a4zif600uh7xu' />
          </datasources>
          <datasource-dependencies datasource='federated.0o0txaw0915gk11a4zif600uh7xu'>
            <column caption='%Cumulative' datatype='real' name='[Calculation_0768577421856768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([sales])) / TOTAL(SUM([sales]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI Achievement' datatype='real' name='[Calculation_1156979309088769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales]) / 10000000' />
            </column>
            <column caption='R_Score' datatype='integer' name='[Calculation_1674300046090244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1674300046209029] &lt;= {FIXED : PERCENTILE([Calculation_1674300046209029], 0.25)} THEN 4&#13;&#10;ELSEIF [Calculation_1674300046209029] &lt;= {FIXED : PERCENTILE([Calculation_1674300046209029], 0.50)} THEN 3&#13;&#10;ELSEIF [Calculation_1674300046209029] &lt;= {FIXED : PERCENTILE([Calculation_1674300046209029], 0.75)} THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='R_Days' datatype='integer' name='[Calculation_1674300046209029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id]: MAX([order_date])}, {MAX([order_date])})' />
            </column>
            <column caption='M_Sales' datatype='integer' name='[Calculation_1674300046512134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_id]: SUM([sales])}' />
            </column>
            <column caption='M_Score' datatype='integer' name='[Calculation_1674300046594055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1674300046512134] &lt;= {FIXED : PERCENTILE([Calculation_1674300046512134], 0.25)} THEN 1&#13;&#10;ELSEIF [Calculation_1674300046512134] &lt;= {FIXED : PERCENTILE([Calculation_1674300046512134], 0.50)} THEN 2&#13;&#10;ELSEIF [Calculation_1674300046512134] &lt;= {FIXED : PERCENTILE([Calculation_1674300046512134], 0.75)} THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
            </column>
            <column caption='F_Orders' datatype='integer' name='[Calculation_1674300046692360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_id]: COUNTD([order_id])}' />
            </column>
            <column caption='F_Score' datatype='integer' name='[Calculation_1674300046897161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1674300046692360] &lt;= {FIXED : PERCENTILE([Calculation_1674300046692360], 0.25)} THEN 1&#13;&#10;ELSEIF [Calculation_1674300046692360] &lt;= {FIXED : PERCENTILE([Calculation_1674300046692360], 0.50)} THEN 2&#13;&#10;ELSEIF [Calculation_1674300046692360] &lt;= {FIXED : PERCENTILE([Calculation_1674300046692360], 0.75)} THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
            </column>
            <column caption='Average revenue per customer' datatype='real' name='[Calculation_1674300047122442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales])&#13;&#10;/COUNTD([customer_id])' />
            </column>
            <column caption='Customer retention rate' datatype='real' name='[Calculation_1674300047245323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id]) / LOOKUP(COUNTD([customer_id]), -ATTR([cohort_index]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Count Customer' datatype='integer' name='[Calculation_1674300047351820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id])' />
            </column>
            <column caption='Average profit per customer' datatype='real' name='[Calculation_1674300047544333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profit])&#13;&#10;/COUNTD([customer_id])' />
            </column>
            <column caption='RFM_String' datatype='string' name='[Calculation_1674300047810575]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Calculation_1674300046090244]) + &quot;-&quot; + STR([Calculation_1674300046897161]) + &quot;-&quot; + STR([Calculation_1674300046594055])' />
            </column>
            <column caption='Segment(RFM)' datatype='string' name='[Calculation_1674300047970320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1674300047810575] = &quot;4-4-4&quot; OR [Calculation_1674300047810575] = &quot;3-4-4&quot; THEN &quot;Most valuable&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;Valuable&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &lt;= 2 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;Churn high spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;New high spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;New low spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;Frequent&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 2 AND [Calculation_1674300046897161] &gt;= 2 AND [Calculation_1674300046594055] &gt;= 2 THEN &quot;Regular&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &lt;= 2 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;Low spending loyal&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Last purchase' datatype='string' name='[Calculation_1674300048138257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR({FIXED [customer_id] : MAX([order_date])})' />
            </column>
