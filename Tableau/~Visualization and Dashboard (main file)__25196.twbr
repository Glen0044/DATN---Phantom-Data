          <calculation class='tableau' formula='IF [Calculation_1674300047810575] = &quot;4-4-4&quot; OR [Calculation_1674300047810575] = &quot;3-4-4&quot; THEN &quot;Most valuable&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;Valuable&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &lt;= 2 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;Churn high spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &gt;= 3 THEN &quot;New high spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;New low spending&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 3 AND [Calculation_1674300046897161] &gt;= 3 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;Frequent&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &gt;= 2 AND [Calculation_1674300046897161] &gt;= 2 AND [Calculation_1674300046594055] &gt;= 2 THEN &quot;Regular&quot;&#13;&#10;ELSEIF [Calculation_1674300046090244] &lt;= 2 AND [Calculation_1674300046897161] &lt;= 2 AND [Calculation_1674300046594055] &lt;= 2 THEN &quot;Low spending loyal&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
        </column>
